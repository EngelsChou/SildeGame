{
  "name": "gogo-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests index.html package.json tsconfig.json",
    "format:check": "prettier --check src tests index.html package.json tsconfig.json"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
